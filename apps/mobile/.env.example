# URL de l'API (exposée au bundle ; ne jamais y mettre de secret)
EXPO_PUBLIC_API_URL=http://localhost:3000/v1
# DSN Sentry ; laisser vide pour désactiver Sentry
EXPO_PUBLIC_SENTRY_DSN=
# Nom d'environnement envoyé à Sentry : local | recette | production
EXPO_PUBLIC_APP_ENV=local
# Mode des données : mock (fixtures de packages/shared) ou http (API réelle)
EXPO_PUBLIC_API_MODE=mock
# Numéro WhatsApp de la marque (chiffres avec indicatif, ex. 228XXXXXXXX). Vide : le bouton « Nous écrire » est masqué.
EXPO_PUBLIC_WHATSAPP_NUMBER=
# Carte de réception (react-native-maps). Mettre true seulement si une clé Google Maps est compilée dans le binaire Android
# (variable GOOGLE_MAPS_ANDROID_API_KEY lue par app.config.js au build, jamais committée). Sinon : saisie du quartier.
EXPO_PUBLIC_MAPS_ENABLED=false
# Identifiant de projet EAS, requis pour obtenir le jeton de notification Expo (extra.eas.projectId via app.config.js)
EAS_PROJECT_ID=
