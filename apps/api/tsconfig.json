{
  "extends": "@streetwear/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "target": "ES2022",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "noEmit": false,
    "outDir": "dist",
    "incremental": true,
    "isolatedModules": false,
    "types": ["node", "jest"]
  },
  "include": ["src", "test", "*.ts"]
}
