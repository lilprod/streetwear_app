# Environnement d'exécution : development | test | production
NODE_ENV=development
# Port HTTP de l'API
PORT=3000
# Niveau de journalisation Pino : fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# URL PostgreSQL (en local : base créée par docker-compose.yml)
DATABASE_URL=postgresql://streetwear:streetwear@localhost:5432/streetwear
# URL Redis (BullMQ, limitation de débit)
REDIS_URL=redis://localhost:6379
# Secret de signature des JWT (min. 32 caractères) ; générer avec : openssl rand -hex 32
JWT_SECRET=
# DSN Sentry ; laisser vide pour désactiver Sentry
SENTRY_DSN=
