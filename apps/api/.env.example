# Environnement d'exécution : development | test | production
NODE_ENV=development
# Port HTTP de l'API
PORT=3000
# Niveau de journalisation Pino : fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# URL PostgreSQL (en local : base créée par docker-compose.yml)
DATABASE_URL=postgresql://streetwear:streetwear@localhost:5432/streetwear
# URL Redis (BullMQ, limitation de débit)
REDIS_URL=redis://localhost:6379
# Secret de signature des JWT (min. 32 caractères) ; générer avec : openssl rand -hex 32
JWT_SECRET=
# DSN Sentry ; laisser vide pour désactiver Sentry
SENTRY_DSN=
# Limite globale de requêtes par minute et par IP
RATE_LIMIT_PER_MINUTE=100
# Audience attendue des idToken Google et Apple (OAuth)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
# Compte super admin créé par le seed (mot de passe >= 12 caractères)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Surcharges optionnelles pour les tests (bases dédiées)
# TEST_DATABASE_URL=postgresql://streetwear:streetwear@localhost:5432/streetwear_test
# TEST_REDIS_URL=redis://localhost:6379/1
# Fournisseur de médias : local (dev/tests, aucun appel réseau) | cloudinary
MEDIA_PROVIDER=local
# URL de base des médias servis par l'adaptateur local
MEDIA_BASE_URL=http://localhost:3000/media
# Cloudinary (requis si MEDIA_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
