# Environnement d'exécution : development | test | production
NODE_ENV=development
# Port HTTP de l'API
PORT=3000
# Niveau de journalisation Pino : fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# URL PostgreSQL (en local : base créée par docker-compose.yml)
DATABASE_URL=postgresql://streetwear:streetwear@localhost:5432/streetwear
# URL Redis (BullMQ, limitation de débit)
REDIS_URL=redis://localhost:6379
# Secret de signature des JWT (min. 32 caractères) ; générer avec : openssl rand -hex 32
JWT_SECRET=
# DSN Sentry ; laisser vide pour désactiver Sentry
SENTRY_DSN=
# Limite globale de requêtes par minute et par IP
RATE_LIMIT_PER_MINUTE=100
# Audience attendue des idToken Google et Apple (OAuth)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
# Compte super admin créé par le seed (mot de passe >= 12 caractères)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Surcharges optionnelles pour les tests (bases dédiées)
# TEST_DATABASE_URL=postgresql://streetwear:streetwear@localhost:5432/streetwear_test
# TEST_REDIS_URL=redis://localhost:6379/1
# Fournisseur de médias : local (dev/tests, aucun appel réseau) | cloudinary
MEDIA_PROVIDER=local
# URL de base des médias servis par l'adaptateur local
MEDIA_BASE_URL=http://localhost:3000/media
# Cloudinary (requis si MEDIA_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Stockage des fichiers d'impression : local (dev/tests) | s3 (S3 ou Cloudflare R2)
STORAGE_PROVIDER=local
# Dossier de l'adaptateur local
STORAGE_LOCAL_DIR=.storage
# URL de base des liens signés de l'adaptateur local
STORAGE_BASE_URL=http://localhost:3000/storage
# S3 / R2 (requis si STORAGE_PROVIDER=s3) ; S3_ENDPOINT vide pour AWS
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Cache disque des motifs et polices téléchargés pour le rendu HD
ASSET_CACHE_DIR=.asset-cache
# Paiement : agrégateur actif (seul « fake » existe tant que l'agrégateur réel n'est pas choisi ; « fake » est refusé en production)
PAYMENT_PROVIDER=fake
# Lien de retour dans l'application après la page de paiement par carte
PAYMENT_RETURN_URL=streetwear://paiement/retour
# Agrégateur simulé : clé HMAC-SHA256 des webhooks (min. 32 caractères) ; générer avec : openssl rand -hex 32
FAKE_PAYMENT_WEBHOOK_SECRET=
# Optionnel (développement) : URL où le fake poste lui-même ses webhooks signés, ex. http://localhost:3000/v1/webhooks/payments/fake
FAKE_PAYMENT_WEBHOOK_URL=
# Délai (ms) avant l'envoi de ces webhooks simulés
FAKE_PAYMENT_DELAY_MS=3000
# Nom de marque inséré dans les SMS (max. 20 caractères) ; non fixé à ce jour
BRAND_NAME=Streetwear
# Clé qui chiffre le code de retrait/remise dans les jobs de la file notifications (min. 32 caractères ; openssl rand -hex 32).
# Obligatoire en production ; vide hors production = dérivée de JWT_SECRET
NOTIFICATION_CODE_KEY=
# Notifications push : fake (aucun réseau) | expo (Expo Push)
PUSH_PROVIDER=fake
# Jeton d'accès Expo Push (optionnel, requis si la sécurité renforcée est activée sur le projet Expo)
EXPO_ACCESS_TOKEN=
# Alertes e-mail de l'équipe : fake (journal seul) | smtp
EMAIL_PROVIDER=fake
# URL SMTP (requise si EMAIL_PROVIDER=smtp), ex. smtps://utilisateur:motdepasse@smtp.exemple.com:465
SMTP_URL=
# Expéditeur des e-mails (requis si EMAIL_PROVIDER=smtp), ex. "Alertes <alertes@exemple.com>"
EMAIL_FROM=
