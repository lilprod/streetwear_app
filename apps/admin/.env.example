# URL de l'API. Vide = même origine (/v1) : en local, Vite relaie /v1 vers l'API
# (API_PROXY_TARGET, défaut http://localhost:3000) ; en recette et en production, le
# reverse proxy sert le back-office et l'API sur le même domaine. L'API n'active pas CORS.
VITE_API_URL=
# true : simule l'API avec MSW (comptes de démo dans apps/admin/README.md)
VITE_USE_MSW=true
# DSN Sentry ; laisser vide pour désactiver Sentry
VITE_SENTRY_DSN=
# Nom d'environnement envoyé à Sentry : local | recette | production
VITE_APP_ENV=local
