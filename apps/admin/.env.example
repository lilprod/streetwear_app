# URL de l'API (utilisée par le back-office dès SP02)
VITE_API_URL=http://localhost:3000/v1
# true : simule l'API avec MSW (comptes de démo dans apps/admin/README.md)
VITE_USE_MSW=true
# DSN Sentry ; laisser vide pour désactiver Sentry
VITE_SENTRY_DSN=
# Nom d'environnement envoyé à Sentry : local | recette | production
VITE_APP_ENV=local
