# Racine : les variables propres à chaque application sont dans apps/<app>/.env.example.
# URL PostgreSQL locale (docker-compose.yml) ; la base de test s'appelle streetwear_test
DATABASE_URL=postgresql://streetwear:streetwear@localhost:5432/streetwear
# URL Redis locale (docker-compose.yml)
REDIS_URL=redis://localhost:6379
